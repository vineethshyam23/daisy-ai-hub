# Backend environment variables
# Copy this to .env and fill in your values. Never commit .env.

# Required: GCP project ID
GCP_PROJECT=your-gcp-project-id

# Optional: GCP region (default is read from config/gcp.yml)
# GCP_REGION=europe-west3

# Optional: career portal Personio XML feed URL (used by /career/interview-questions and /career/open-positions)
# CAREER_PORTAL_XML_FEED_URL=https://your-company.jobs.personio.de/xml
